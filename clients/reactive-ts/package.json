{
  "name": "@opto-sync/reactive",
  "version": "0.3.0",
  "private": true,
  "description": "RxJS orchestration for opto-sync optimism policies, session-scoped source fusion, background sync, and live transport hints",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./desktop": "./src/desktop.ts",
    "./service-worker": "./src/service-worker.ts",
    "./sqlite-desktop": "./src/sqlite-desktop.ts",
    "./node-tcp": "./src/node-tcp.ts"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "scripts": {
    "test:contract": "python3 ../../contract/bin/check_surface.py --lang reactive-ts",
    "pretest": "python3 ../../contract/bin/check_surface.py --lang reactive-ts",
    "prepublishOnly": "python3 ../../contract/bin/check_surface.py --prepublish --lang reactive-ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:browser": "node test/service-worker-browser.mjs",
    "measure:pilot": "node tool/measure-pilot.mjs"
  },
  "keywords": [
    "rxjs",
    "offline-first",
    "service-worker",
    "desktop",
    "indexeddb",
    "supabase",
    "websocket",
    "background-sync"
  ],
  "license": "MIT",
  "dependencies": {
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "@opto-sync/client": "^0.2.0 || ^0.3.0 || ^0.4.0"
  },
  "peerDependenciesMeta": {
    "@opto-sync/client": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
