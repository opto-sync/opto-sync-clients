{
  "name": "@opto-sync/reactive",
  "version": "0.1.0",
  "private": true,
  "description": "RxJS orchestration for opto-sync optimism policies, session-scoped source fusion, background sync, and live transport hints",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./desktop": "./src/desktop.ts",
    "./service-worker": "./src/service-worker.ts",
    "./sqlite-desktop": "./src/sqlite-desktop.ts",
    "./node-tcp": "./src/node-tcp.ts"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:browser": "node test/service-worker-browser.mjs",
    "lint:ores": "if [ -f ../../.ores-lint/lint.sh ]; then sh ../../.ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "keywords": [
    "rxjs",
    "offline-first",
    "service-worker",
    "desktop",
    "indexeddb",
    "supabase",
    "websocket",
    "background-sync"
  ],
  "license": "MIT",
  "dependencies": {
    "rxjs": "7.8.2"
  },
  "peerDependencies": {
    "@opto-sync/client": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@opto-sync/client": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
