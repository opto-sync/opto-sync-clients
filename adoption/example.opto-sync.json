{
  "schemaVersion": "opto-sync.adoption.v1",
  "project": "example/example-clients",
  "clientPackage": {
    "package": "opto-sync/opto-sync-clients",
    "repository": "https://github.com/opto-sync/opto-sync-clients",
    "version": "0.2.0",
    "commit": "068414c8ff7d4262d0a395959b5209d5908f0fcc"
  },
  "languages": [
    "dart",
    "rust",
    "typescript"
  ],
  "dataScopes": [
    "documents",
    "preferences"
  ],
  "localStores": [
    "indexeddb",
    "sqlite"
  ],
  "transports": [
    "http",
    "websocket"
  ],
  "writeStrategies": [
    "local-durable",
    "local-then-remote"
  ],
  "conflictPolicy": {
    "arrayStrategy": "mergeByKey",
    "resolveByTimestamp": true,
    "lwwKeys": [
      "updatedAt"
    ],
    "arrayMatchKeys": [
      "id"
    ],
    "tombstones": true
  },
  "background": {
    "webServiceWorker": true,
    "mobileWorker": true,
    "desktopWorker": true
  },
  "security": {
    "authenticatedTransport": true,
    "encryptedAtRest": true,
    "secretsInManifest": false
  },
  "rollout": {
    "phase": "declared",
    "owners": [
      "example-platform"
    ]
  },
  "notes": "The manifest declares the intended boundary. Advancing rollout phases requires behavioral tests in the adopting repository."
}
