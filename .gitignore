# Dependencies / build output
**/node_modules/
**/dist/
**/target/
**/.dart_tool/
**/build/
**/_build/
**/deps/
**/__pycache__/
**/bin/
**/obj/
*.py[cod]

# The exported-surface verifier is authored source, not a generated language
# build directory. Keep this single tool directory visible while retaining the
# repository-wide build-output exclusion above.
!contract/bin/
!contract/bin/*.py
!contract/bin/*.sh

# Formal-methods runtime output
.formal-artifacts/
_apalache-out/

# Zed deterministic package output plus reviewed source lifecycle hooks.
.zed/
!.zed/
.zed/*
!.zed/pre-install
!.zed/post-install
!.zed/pre-build
!.zed/post-build
!.zed/pre-pack
!.zed/pre-publish
.zed-pack/

# OS / IDE
.DS_Store
*.swp
.vscode/
.idea/

# Gradle build caches (never tracked)
**/.gradle/
tmp
temp
tmp/worktrees
temp/worktrees

# Local cross-repository E2E worktree materialization
e2e-lock-space/

# Encrypted environment custody. Only the reviewed ciphertext profiles may be
# tracked; plaintext and private age identities remain local.
.env
.env.*
*.env.*
!.env.example
*.env
**/*.env
env/dec/
env/enc/*
!env/enc/dev.env.enc
!env/enc/prod.env.enc
*.agekey
*.age-key
keys.txt
sops-private*.txt
