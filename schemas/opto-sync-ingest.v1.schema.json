{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opto-sync.dev/schemas/opto-sync-ingest.v1.schema.json",
  "title": "opto-sync ingest document v1",
  "description": "A validated, transport-neutral batch of mutations that can be queued in IndexedDB or SQLite and synchronized through protocol v1 to PostgreSQL or Supabase.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "batchId",
    "createdAt",
    "mutations"
  ],
  "properties": {
    "format": {
      "const": "opto-sync.ingest.v1"
    },
    "batchId": {
      "$ref": "#/$defs/scopeId",
      "description": "Caller-assigned diagnostic/idempotency identity for this source batch."
    },
    "createdAt": {
      "$ref": "#/$defs/syncTimestamp"
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/upsert"
          },
          {
            "$ref": "#/$defs/delete"
          }
        ]
      }
    }
  },
  "$defs": {
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "recordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "canonicalRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "syncTimestamp": {
      "description": "A fixed-width opto-sync HLC, an RFC 3339 UTC/offset timestamp, or a canonical unsigned decimal string. Numeric JSON values are intentionally rejected because JavaScript cannot preserve every 64-bit timestamp.",
      "type": "string",
      "anyOf": [
        {
          "pattern": "^[0-9]{13}-[0-9a-f]{4}-[A-Za-z0-9._:]+$"
        },
        {
          "format": "date-time"
        },
        {
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      ]
    },
    "record": {
      "type": "object",
      "required": [
        "updatedAt"
      ],
      "properties": {
        "updatedAt": {
          "$ref": "#/$defs/syncTimestamp"
        },
        "createdAt": {
          "$ref": "#/$defs/syncTimestamp"
        },
        "syncedAt": {
          "$ref": "#/$defs/syncTimestamp"
        }
      },
      "additionalProperties": true
    },
    "upsert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "table",
        "recordId",
        "record"
      ],
      "properties": {
        "operation": {
          "const": "upsert"
        },
        "table": {
          "$ref": "#/$defs/scopeId"
        },
        "recordId": {
          "$ref": "#/$defs/recordId"
        },
        "record": {
          "$ref": "#/$defs/record"
        },
        "baseRevision": {
          "$ref": "#/$defs/canonicalRevision"
        },
        "resurrect": {
          "type": "boolean"
        }
      }
    },
    "delete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "table",
        "recordId",
        "deletedAt"
      ],
      "properties": {
        "operation": {
          "const": "delete"
        },
        "table": {
          "$ref": "#/$defs/scopeId"
        },
        "recordId": {
          "$ref": "#/$defs/recordId"
        },
        "deletedAt": {
          "$ref": "#/$defs/syncTimestamp"
        },
        "baseRevision": {
          "$ref": "#/$defs/canonicalRevision"
        }
      }
    }
  }
}
