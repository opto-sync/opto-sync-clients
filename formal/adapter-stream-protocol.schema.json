{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oresoftware.github.io/formal-methods/schemas/adapter-stream-protocol.v1.json",
  "title": "Formal methods streaming adapter protocol v1",
  "description": "One UTF-8 JSON object per line for deterministic model-to-implementation conformance. The legacy fmctl.adapter.v1 batch replay contract remains separately versioned.",
  "oneOf": [
    { "$ref": "#/$defs/requestMessage" },
    { "$ref": "#/$defs/responseMessage" }
  ],
  "$defs": {
    "protocol": {
      "const": "fm.adapter.stream.v1"
    },
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,15}$",
      "description": "Strictly increasing canonical decimal identifier, additionally bounded to 2^53-1 by the runtime validator."
    },
    "machine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonicalValue": {
      "description": "Canonical JSON value. Runtime validation rejects floating-point numbers and normalizes ITF #bigint, #set, and #map values.",
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "string" },
        { "type": "integer" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/canonicalValue" }
        }
      ]
    },
    "helloOperation": {
      "type": "object",
      "properties": { "name": { "const": "hello" } },
      "required": ["name"],
      "additionalProperties": false
    },
    "resetOperation": {
      "type": "object",
      "properties": {
        "name": { "const": "reset" },
        "initialState": { "$ref": "#/$defs/canonicalValue" },
        "seed": { "type": "string", "minLength": 1 },
        "logicalTime": { "$ref": "#/$defs/canonicalValue" }
      },
      "required": ["name", "initialState", "logicalTime"],
      "additionalProperties": false
    },
    "applyOperation": {
      "type": "object",
      "properties": {
        "name": { "const": "apply" },
        "action": { "type": "string", "minLength": 1, "maxLength": 256 },
        "arguments": { "$ref": "#/$defs/canonicalValue" },
        "logicalTime": { "$ref": "#/$defs/canonicalValue" }
      },
      "required": ["name", "action", "logicalTime"],
      "additionalProperties": false
    },
    "observeOperation": {
      "type": "object",
      "properties": { "name": { "const": "observe" } },
      "required": ["name"],
      "additionalProperties": false
    },
    "settleOperation": {
      "type": "object",
      "properties": {
        "name": { "const": "settle" },
        "maxSteps": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      },
      "required": ["name", "maxSteps"],
      "additionalProperties": false
    },
    "snapshotOperation": {
      "type": "object",
      "properties": { "name": { "const": "snapshot" } },
      "required": ["name"],
      "additionalProperties": false
    },
    "restoreOperation": {
      "type": "object",
      "properties": {
        "name": { "const": "restore" },
        "snapshot": { "$ref": "#/$defs/canonicalValue" },
        "schemaHash": { "$ref": "#/$defs/sha256" }
      },
      "required": ["name", "snapshot", "schemaHash"],
      "additionalProperties": false
    },
    "faultOperation": {
      "type": "object",
      "properties": {
        "name": { "const": "fault" },
        "fault": { "type": "string", "minLength": 1, "maxLength": 256 },
        "arguments": { "$ref": "#/$defs/canonicalValue" }
      },
      "required": ["name", "fault"],
      "additionalProperties": false
    },
    "closeOperation": {
      "type": "object",
      "properties": { "name": { "const": "close" } },
      "required": ["name"],
      "additionalProperties": false
    },
    "operation": {
      "oneOf": [
        { "$ref": "#/$defs/helloOperation" },
        { "$ref": "#/$defs/resetOperation" },
        { "$ref": "#/$defs/applyOperation" },
        { "$ref": "#/$defs/observeOperation" },
        { "$ref": "#/$defs/settleOperation" },
        { "$ref": "#/$defs/snapshotOperation" },
        { "$ref": "#/$defs/restoreOperation" },
        { "$ref": "#/$defs/faultOperation" },
        { "$ref": "#/$defs/closeOperation" }
      ]
    },
    "operationName": {
      "enum": [
        "hello",
        "reset",
        "apply",
        "observe",
        "settle",
        "snapshot",
        "restore",
        "fault",
        "close"
      ]
    },
    "streamError": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "retryable": { "type": "boolean" },
        "data": { "$ref": "#/$defs/canonicalValue" }
      },
      "required": ["code", "message", "retryable"],
      "additionalProperties": false
    },
    "okOutcome": {
      "type": "object",
      "properties": {
        "kind": { "const": "ok" },
        "value": { "$ref": "#/$defs/canonicalValue" }
      },
      "required": ["kind", "value"],
      "additionalProperties": false
    },
    "errorOutcome": {
      "type": "object",
      "properties": {
        "kind": { "const": "error" },
        "error": { "$ref": "#/$defs/streamError" }
      },
      "required": ["kind", "error"],
      "additionalProperties": false
    },
    "unsupportedOutcome": {
      "type": "object",
      "properties": {
        "kind": { "const": "unsupported" },
        "error": { "$ref": "#/$defs/streamError" }
      },
      "required": ["kind", "error"],
      "additionalProperties": false
    },
    "outcome": {
      "oneOf": [
        { "$ref": "#/$defs/okOutcome" },
        { "$ref": "#/$defs/errorOutcome" },
        { "$ref": "#/$defs/unsupportedOutcome" }
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "machine": { "$ref": "#/$defs/machine" },
        "generation": { "$ref": "#/$defs/generation" },
        "operation": { "$ref": "#/$defs/operation" }
      },
      "required": [
        "protocol",
        "protocolVersion",
        "requestId",
        "machine",
        "generation",
        "operation"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "machine": { "$ref": "#/$defs/machine" },
        "generation": { "$ref": "#/$defs/generation" },
        "operation": { "$ref": "#/$defs/operationName" },
        "outcome": { "$ref": "#/$defs/outcome" }
      },
      "required": [
        "protocol",
        "protocolVersion",
        "requestId",
        "machine",
        "generation",
        "operation",
        "outcome"
      ],
      "additionalProperties": false
    },
    "requestMessage": {
      "type": "object",
      "properties": {
        "kind": { "const": "request" },
        "message": { "$ref": "#/$defs/request" }
      },
      "required": ["kind", "message"],
      "additionalProperties": false
    },
    "responseMessage": {
      "type": "object",
      "properties": {
        "kind": { "const": "response" },
        "message": { "$ref": "#/$defs/response" }
      },
      "required": ["kind", "message"],
      "additionalProperties": false
    }
  }
}
