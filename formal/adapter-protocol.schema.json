{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opto-sync.dev/schemas/fmctl-adapter-v1.json",
  "title": "fmctl adapter protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/replayRequest" },
    { "$ref": "#/$defs/replayResponse" }
  ],
  "$defs": {
    "replayRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "project",
        "model",
        "adapter",
        "specification",
        "traces"
      ],
      "properties": {
        "protocol": { "const": "fmctl.adapter.v1" },
        "project": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "specification": { "type": "string", "minLength": 1 },
        "traces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "name", "version"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace",
        "step",
        "action",
        "message",
        "expected",
        "actual"
      ],
      "properties": {
        "trace": { "type": "string", "minLength": 1 },
        "step": { "type": ["integer", "null"], "minimum": 0 },
        "action": { "type": ["string", "null"] },
        "message": { "type": "string", "minLength": 1 },
        "expected": {},
        "actual": {}
      }
    },
    "replayResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "success",
        "traces_total",
        "traces_passed",
        "mismatches",
        "implementation"
      ],
      "properties": {
        "protocol": { "const": "fmctl.adapter.v1" },
        "success": { "type": "boolean" },
        "traces_total": { "type": "integer", "minimum": 0 },
        "traces_passed": { "type": "integer", "minimum": 0 },
        "mismatches": {
          "type": "array",
          "items": { "$ref": "#/$defs/mismatch" }
        },
        "implementation": { "$ref": "#/$defs/implementation" }
      }
    }
  }
}
